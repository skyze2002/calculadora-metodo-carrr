# Copiar a .env en el servidor (chmod 600). NUNCA commitear el .env real.
OPENAI_API_KEY=
SERPAPI_KEY=
ZILLAPI_KEY=
SCRAPER_API_KEY=
SCRAPER_PREMIUM=
# Debe coincidir con la APP_KEY compilada en la app (config.local.json).
APP_KEY=
CORS_ORIGINS=https://localhost,capacitor://localhost,http://localhost
# 1 = solo Caddy delante. 2 = Cloudflare (nube naranja) + Caddy.
TRUSTED_PROXY_HOPS=1
