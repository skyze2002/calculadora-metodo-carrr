# Copiar a .env y ajustar. NO commitear .env.

# Conexión a Postgres. El contenedor expone el 5433 en el host para no chocar
# con un Postgres local que suele estar en el 5432.
DATABASE_URL=postgresql+psycopg://brrrr:brrrr@localhost:5433/brrrr

# API key de OpenAI para el análisis con IA (endpoint /deals/explain).
# En Render se pone como variable secreta, NO acá. (Opcional: OPENAI_MODEL)
OPENAI_API_KEY=sk-...
