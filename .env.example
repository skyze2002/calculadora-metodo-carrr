# Copiar a .env y ajustar. NO commitear .env.

# Conexión a Postgres. El contenedor expone el 5433 en el host para no chocar
# con un Postgres local que suele estar en el 5432.
DATABASE_URL=postgresql+psycopg://brrrr:brrrr@localhost:5433/brrrr

# API key de OpenAI para el análisis con IA (endpoint /deals/explain).
# En Render se pone como variable secreta, NO acá. (Opcional: OPENAI_MODEL)
OPENAI_API_KEY=sk-...

# Modelo del buscador de productos. Debe soportar Responses y web_search.
# No reemplaza el modelo del análisis de deals.
OPENAI_PRODUCTS_MODEL=gpt-4.1-mini

# Llave de app: cierra los endpoints de IA a quien no sea nuestra app. Debe
# coincidir con VITE_APP_KEY del frontend (frontend/.env.production.local).
# En Render va como variable secreta. Si se deja vacía, no se exige (solo dev).
APP_KEY=

# Orígenes permitidos para CORS (lista separada por comas). En dev no hace falta.
# En Render: "https://localhost,capacitor://localhost,http://localhost" + tu
# dominio de Vercel si usás la web.
CORS_ORIGINS=

# Servicio de scraping (scraperapi.com) para leer portales que bloquean las IPs
# de servidor (Zillow, Realtor, Redfin) al autocompletar desde un link. Opcional:
# sin esta key, "Traer link" solo funciona en sitios que no bloquean.
SCRAPER_API_KEY=
# Pool del scraper. Los pools premium/residenciales (los unicos que leen Zillow)
# requieren un plan PAGO de ScraperAPI. Valores: "" (default, plan free),
# "premium" o "ultra". En plan free dejalo vacio; al pagar, poné "ultra".
SCRAPER_PREMIUM=
# Ejecutar el JS de la pagina en el scraper ("true"/"false", default "true").
SCRAPER_RENDER=

# Zillapi (zillapi.com): lee inmuebles de Zillow por URL, ya estructurados.
# Zillow bloquea el scraping comun, asi que para "Traer link" de Zillow se usa
# esta API. Tiene 100 consultas gratis. La key empieza con "zk_".
ZILLAPI_KEY=
